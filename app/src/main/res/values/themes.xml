<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base application theme. The actual Material3 theming is applied in Compose. -->
    <style name="Theme.GymApp" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/gym_launch_background</item>
        <item name="android:statusBarColor">@color/gym_launch_background</item>
        <item name="android:navigationBarColor">@color/gym_launch_background</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>

    <style name="Theme.GymApp.Splash" parent="Theme.GymApp" />
</resources>
